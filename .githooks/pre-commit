#!/usr/bin/env bash
# Blocks a commit if the test suite fails. Wired up automatically via
# package.json's postinstall (git config core.hooksPath .githooks) - see
# CONTRIBUTING.md. Plain script on purpose, no husky/dependency: this repo
# stays dependency-light by policy.
set -e

echo "Running tests before commit..."
npm test

# Remember which exact code passed, so ~/bin/ship does not run the same suite a second time.
git write-tree > "$(git rev-parse --git-dir)/tests-passed"
